+// ---- Benchmark-only nine-action performance sequence -----------------------
+//
+// Gated by SCRATCHPAD_ALICORN_PERF_SEQUENCE=1 and used only by the isolated
+// matched A/B copy of Scratchpad. Each step invokes the same application or
+// backend command path a user action reaches; no native input is synthesized.
+// Per-step action time is the wall time spent inside the command dispatch.
+// Per-step build time credits every application description that happens
+// between this step and the next, which attributes the frame work the action
+// caused even though the host builds that frame after this callback returns.
+
+scratchpad_performance_sequence_schedule :: proc(app: ^App) {
+	if app == nil || !app.performance_sequence_enabled || app.performance_sequence_complete || app.performance_sequence_failed { return }
+	_ = alicorn.application_schedule_after(app.services.scheduler, .Frequent, 30_000_000)
+}
+
+// The first step waits for the startup description and the initial present to
+// settle. A step dispatched into the first 150 ms of startup waits on backend
+// lanes that are still initializing, which turns a command into multi-second
+// lock contention and is not representative of an interaction.
+scratchpad_performance_sequence_start :: proc(app: ^App) {
+	if app == nil || !app.performance_sequence_enabled { return }
+	_ = alicorn.application_schedule_after(app.services.scheduler, .Frequent, 500_000_000)
+}
+
+scratchpad_performance_sequence_fail :: proc(app: ^App, message: string) {
+	if app == nil { return }
+	app.performance_sequence_failed = true
+	fmt.eprintln("alicorn-performance-sequence failed", "step", app.performance_sequence_steps, message)
+}
+
+scratchpad_performance_sequence_record_action :: proc(app: ^App, step: int, start: time.Tick) {
+	if app == nil || step < 0 || step >= len(app.performance_sequence_action_ns) { return }
+	elapsed := time.duration_nanoseconds(time.tick_diff(start, time.tick_now()))
+	if elapsed > 0 { app.performance_sequence_action_ns[step] += u64(elapsed) }
+}
+
+scratchpad_performance_sequence_credit_build :: proc(app: ^App, start: time.Tick, measured: bool) {
+	if app == nil || !measured || !app.performance_sequence_enabled { return }
+	index := app.performance_sequence_attribution
+	if index < 0 || index >= len(app.performance_sequence_build_ns) { return }
+	elapsed := time.duration_nanoseconds(time.tick_diff(start, time.tick_now()))
+	if elapsed <= 0 { return }
+	app.performance_sequence_build_ns[index] += u64(elapsed)
+	app.performance_sequence_builds[index] += 1
+}
+
+scratchpad_performance_sequence_open :: proc(app: ^App, rt: ^alicorn.Runtime, relative_path: string) -> bool {
+	if app == nil || rt == nil || !app.backend.state.has_workspace { return false }
+	path := fmt.tprintf("%s/%s", app.backend.state.workspace_root, relative_path)
+	response := bridge.backend_command(&app.backend, "open_path", path=path)
+	opened := response.ok
+	if opened {
+		handle_command_result(app, rt, &response)
+	} else {
+		fmt.eprintln("alicorn-performance-sequence open failed", relative_path, response.code, response.message)
+	}
+	bridge.backend_command_result_destroy(&response, context.allocator)
+	return opened
+}
+
+scratchpad_performance_sequence_step :: proc(app: ^App, rt: ^alicorn.Runtime) {
+	if app == nil || rt == nil || app.performance_sequence_complete || app.performance_sequence_failed { return }
+	if !app.smoke_rendered || !app.backend.state.has_workspace {
+		if !app.backend.state.has_workspace {
+			fmt.eprintln("alicorn-performance-sequence workspace state", "requested", app.workspace_path, "available", app.backend.state.has_workspace)
+		}
+		scratchpad_performance_sequence_schedule(app)
+		return
+	}
+	step := app.performance_sequence_steps
+	if step >= 9 {
+		// Settle the final step's declaration frame before declaring completion
+		// so the last close is measured like every other step.
+		if app.performance_sequence_builds[8] == 0 {
+			scratchpad_performance_sequence_schedule(app)
+			return
+		}
+		app.performance_sequence_attribution = -1
+		app.performance_sequence_complete = true
+		return
+	}
+	// Advance only after the previous step's description was built. This keeps
+	// one command per frame instead of stacking commands ahead of the runtime.
+	if step > 0 && app.performance_sequence_builds[step-1] == 0 {
+		scratchpad_performance_sequence_schedule(app)
+		return
+	}
+	app.performance_sequence_attribution = step
+	action_start := time.tick_now()
+	advanced := false
+	switch step {
+	case 0:
+		if scratchpad_performance_sequence_open(app, rt, "README.md") { advanced = true }
+	case 1:
+		if scratchpad_performance_sequence_open(app, rt, "application/sample_00.go") { advanced = true }
+	case 2:
+		for document in app.backend.state.documents {
+			if strings.has_suffix(document.path, "README.md") {
+				select_document(app, rt, document.id)
+				active, found := find_document(&app.backend.state, app.backend.state.active)
+				advanced = found && strings.has_suffix(active.path, "README.md")
+				break
+			}
+		}
+	case 3:
+		quick_open_open_surface(app, rt)
+		advanced = app.quick_open_open
+	case 4:
+		if app.quick_open_open && !app.quick_open_ready {
+			scratchpad_performance_sequence_schedule(app)
+			return
+		}
+		if app.quick_open_open { quick_open_close_surface(app, rt, true) }
+		advanced = !app.quick_open_open
+	case 5:
+		dispatch_action(app, rt, ACTION_WORKSPACE_SETTINGS)
+		advanced = app.settings_surface_open
+	case 6:
+		settings_surface_close(app, rt, true)
+		advanced = !app.settings_surface_open
+	case 7, 8:
+		expected_document_count := 1 if step == 8 else 2
+		if len(app.backend.state.documents) >= expected_document_count {
+			if !app.performance_sequence_step_started {
+				app.performance_sequence_step_started = true
+				dispatch_start := time.tick_now()
+				dispatch_action(app, rt, ACTION_DOCUMENT_CLOSE)
+				scratchpad_performance_sequence_record_action(app, step, dispatch_start)
+			}
+			if len(app.backend.state.documents) >= expected_document_count {
+				scratchpad_performance_sequence_schedule(app)
+				return
+			}
+		}
+		advanced = true
+	case:
+		app.performance_sequence_complete = app.performance_sequence_steps == 9
+		return
+	}
+	if !advanced {
+		scratchpad_performance_sequence_fail(app, "action did not reach its expected state")
+		return
+	}
+	if step != 7 && step != 8 {
+		scratchpad_performance_sequence_record_action(app, step, action_start)
+	}
+	app.performance_sequence_step_started = false
+	app.performance_sequence_steps += 1
+	scratchpad_performance_sequence_schedule(app)
+}
+
