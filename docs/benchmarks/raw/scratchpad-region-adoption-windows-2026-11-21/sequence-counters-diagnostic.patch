+scratchpad_performance_sequence_report_counters :: proc(app: ^App, rt: ^alicorn.Runtime, step: int) {
+	if app == nil || rt == nil { return }
+	now := alicorn.frame_stats_snapshot(rt)
+	if app.performance_sequence_stats_valid {
+		before := app.performance_sequence_stats_mark
+		fmt.println(
+			"alicorn-performance-sequence-counters",
+			"step", step,
+			"emitted", now.descriptions_emitted-before.descriptions_emitted,
+			"reused", now.descriptions_reused-before.descriptions_reused,
+			"regions_skipped", now.regions_skipped-before.regions_skipped,
+			"retained_reused", now.retained_subtrees_reused-before.retained_subtrees_reused,
+			"reconcile_nodes", now.reconcile_nodes_visited-before.reconcile_nodes_visited,
+			"layout_nodes", now.layout_nodes_visited-before.layout_nodes_visited,
+			"paint_nodes", now.paint_nodes_visited-before.paint_nodes_visited,
+			"composition_nodes", now.composition_nodes_visited-before.composition_nodes_visited,
+			"text_shapes", now.text_shape_requests-before.text_shape_requests,
+		)
+	}
+	app.performance_sequence_stats_mark = now
+	app.performance_sequence_stats_valid = true
+}
+
 scratchpad_performance_sequence_open :: proc(app: ^App, rt: ^alicorn.Runtime, relative_path: string) -> bool {
 	if app == nil || rt == nil || !app.backend.state.has_workspace { return false }
 	path := fmt.tprintf("%s/%s", app.backend.state.workspace_root, relative_path)
