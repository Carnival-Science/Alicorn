+// quick_open_results_region_signature is the complete input set for the
+// result slot. Query text and index generation are the data identity; the
+// realized scroll window, selection highlight, and pending interaction are
+// application-polled inputs the slot's output depends on. Theme and
+// accessibility affect button colors/underlines resolved during description.
+quick_open_results_region_signature :: proc(app: ^App, rt: ^alicorn.Runtime) -> u64 {
+	hash := REGION_HASH_OFFSET
+	hash = region_hash_string(hash, app.quick_open_query)
+	hash = region_hash_mix(hash, app.quick_open_generation)
+	hash = region_hash_bool(hash, app.quick_open_loading)
+	hash = region_hash_bool(hash, app.quick_open_ready)
+	hash = region_hash_string(hash, app.quick_open_error)
+	hash = region_hash_bool(hash, app.quick_open_truncated)
+	// The retained path array is the filter input. Generation normally covers
+	// replacement; the length also catches a same-generation resize and keeps
+	// the result-slot revision tied to the actual source set.
+	hash = region_hash_mix(hash, u64(len(app.quick_open_paths)))
+	hash = region_hash_mix(hash, u64(max(app.quick_open_selected_index, 0)))
+	hash = region_hash_mix(hash, u64(app.editor_theme))
+	hash = region_hash_mix(hash, u64(app.workbench_theme))
+	if rt != nil {
+		hash = region_hash_mix(hash, u64(rt.activation_node))
+		hash = region_hash_mix(hash, u64(rt.activation_sequence))
+		hash = region_hash_mix(hash, u64(rt.focused))
+		hash = region_hash_bool(hash, rt.focus_visible)
+		preferences := alicorn.style_root_accessibility_observation_get(rt).preferences
+		hash = region_hash_bool(hash, preferences.differentiate_without_color)
+	}
+	if scroll_node := app.quick_open_results_scroll_node; scroll_node != 0 {
+		if info, found := alicorn.node_info(rt, scroll_node); found {
+			hash = region_hash_f32(hash, info.scroll_offset_y)
+			hash = region_hash_f32(hash, info.scroll_viewport_height)
+		}
+	}
+	return hash
+}
+
+// quick_open_results_invalidate advances the slot generation *before* the
+// next description, so the cached node is uncached with the same revision the
+// describe will compute. It never re-enters the application.
+quick_open_results_invalidate :: proc(app: ^App, rt: ^alicorn.Runtime, reason: string) {
+	if app == nil || rt == nil { return }
+	revision := region_generation_next(&app.quick_open_results_region, quick_open_results_region_signature(app, rt))
+	alicorn.invalidate_region(rt, "scratchpad-quick-open-results", revision, reason)
+}
