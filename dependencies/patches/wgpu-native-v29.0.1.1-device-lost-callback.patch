+fn dispatch_device_lost(
+    sink_mutex: &Mutex<ErrorSinkRaw>,
+    reason: native::WGPUDeviceLostReason,
+    message: String,
+) {
+    let (handler, device) = {
+        let mut sink = sink_mutex.lock();
+        (sink.device_lost_handler.take(), sink.device.upgrade())
+    };
+
+    let Some(handler) = handler else {
+        return;
+    };
+    let Some(callback) = handler.callback else {
+        return;
+    };
+
+    // Keep the wrapper alive for the duration of the callback when the C handle
+    // still exists. The C API permits a null handle after its last ref is released.
+    let device: native::WGPUDevice = device
+        .as_ref()
+        .map_or(std::ptr::null(), |device| Arc::as_ptr(device));
+    unsafe {
+        callback(
+            &device,
+            reason,
+            str_into_string_view(&message),
+            handler.userdata.get_1(),
+            handler.userdata.get_2(),
+        );
+    }
+}
