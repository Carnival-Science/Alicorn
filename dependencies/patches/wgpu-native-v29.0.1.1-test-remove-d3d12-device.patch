+/// TEST-ONLY, NOT PART OF THE WEBGPU C API.
+///
+/// Forces the native D3D12 device behind a wgpu device into a removed state by
+/// calling `ID3D12Device5::RemoveDevice`. Returns whether the removal call was
+/// issued. This exists only for Alicorn's induced-backend-removal validation
+/// (the third rung of its device-loss ladder) and must not be used by
+/// production code: it deliberately corrupts a live device.
+///
+/// Deliberately absent from `ffi/wgpu.h`; callers resolve the symbol by name.
+#[no_mangle]
+pub unsafe extern "C" fn wgpuDeviceRemoveD3D12ForTesting(
+    device: native::WGPUDevice,
+) -> native::WGPUBool {
+    #[cfg(all(windows, feature = "dx12"))]
+    {
+        use windows::core::Interface as _;
+
+        let device = device.as_ref().expect("invalid device");
+        let Some(hal_device) = device.context.device_as_hal::<hal::api::Dx12>(device.id) else {
+            return false as native::WGPUBool;
+        };
+        let Ok(device5) = hal_device
+            .raw_device()
+            .cast::<windows::Win32::Graphics::Direct3D12::ID3D12Device5>()
+        else {
+            return false as native::WGPUBool;
+        };
+        device5.RemoveDevice();
+        true as native::WGPUBool
+    }
+    #[cfg(not(all(windows, feature = "dx12")))]
+    {
+        let _ = device;
+        false as native::WGPUBool
+    }
+}
